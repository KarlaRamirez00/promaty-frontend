# URLs base de cada microservicio del backend.
# Hoy no hay API gateway: el frontend consume cada servicio directo en su puerto.
# El gateway (gateway-server, puerto 8083) es un servicio posterior; cuando exista,
# estas tres variables colapsan a una sola VITE_API_URL apuntando al gateway.
#
# Copiar a `.env` y reemplazar con los valores reales que entrega el backend.

VITE_USER_API_URL=http://localhost:8081
VITE_AUTH_API_URL=http://localhost:8082
VITE_RRHH_API_URL=http://localhost:8085
