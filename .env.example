# URL base del backend. gateway-server (2026-09) enruta por path a los 3 servicios de negocio
# (auth/user/rrhh) y valida el JWT — mismos paths de siempre (/roles, /clients, /projects, etc.),
# sin prefijo /api.
#
# Copiar a `.env` y reemplazar con el valor real que entrega el backend.

VITE_API_URL=http://localhost:8083
